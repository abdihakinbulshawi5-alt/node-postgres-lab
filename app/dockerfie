#===========
# stage |:Builder
#==========
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json./
RUN npm install
COPY app.js./
#===========
# stage 2: production
#===========
FROM node:22-apline
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder --chown=node:node /app/node.modules./nodel_modules
COPY --from=builder --chown=node:node /app/package.json./
COPY --from=builder --chown=node:node /app/app.json./
USER node
EXPOSE 3000
CMD{"node","app.json"}
